+"""Replay only native MCP argument formatting in the exact no-network actor image."""
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+from uuid import uuid4
+
+from opencode_runtime import save_json
+
+IMAGE = 'sha256:921ad705b87e7d8653a0bff00a68610b8adc72c318c914751d81ddb165f8c4da'
+SCHEMA_SHA = '6edad6fceba674fff60b72d971a467bf86929b6213432b311c6404ac19960352'
+MCP_SHA = '3e07571f7e82c11281af5d19ce6f11d3492861f132bab43aca781adfe2435f52'
+
+# No task execution, imports of user-supplied modules, network, credentials,
+# benchmark persona, or grader data. Only JSON arguments + public tool schemas.
+REPLAY_CODE = '''
+import hashlib, inspect, json, pathlib, sys
+from openjiuwen.core.common.utils.schema_utils import SchemaUtils
+from openjiuwen.core.foundation.tool.mcp.base import MCPTool
+hashes = {name: hashlib.sha256(pathlib.Path(inspect.getfile(cls)).read_bytes()).hexdigest()
+          for name, cls in [('schema', SchemaUtils), ('mcp', MCPTool)]}
+results = {}
+for cid, row in json.load(sys.stdin).items():
+    try:
+        value = SchemaUtils.format_with_schema(row['arguments'], row['schema'],
+                                               skip_none_value=False, skip_validate=False)
+        results[cid] = {'ok': True, 'arguments': SchemaUtils.remove_none_values(value) or {}}
+    except Exception as exc:
+        results[cid] = {'ok': False, 'error_type': type(exc).__name__}
+print('CLAW_SCHEMA_REPLAY=' + json.dumps({'hashes': hashes, 'results': results}, ensure_ascii=True))
+'''
+
+
+def format_in_frozen_image(inputs, output):
+    name = 'claw-fenglitong-schema-' + uuid4().hex[:16]
+    command = ['docker', '--host', 'unix:///run/docker-claw-eval.sock', 'run', '--rm', '-i',
+        '--name', name, '--label', 'app=claw-eval', '--label', 'owner=fenglitong',
+        '--label', 'purpose=postprocess-schema-replay', '--network', 'none', '--read-only',
+        '--cap-drop=ALL', '--security-opt', 'no-new-privileges', '--memory', '1g', '--cpus', '1',
+        '--pids-limit', '64', '--tmpfs', '/tmp:rw,nosuid,size=128m', '--workdir', '/tmp',
+        '--entrypoint', '/opt/jiuwenswarm-venv/bin/python', IMAGE, '-B', '-c', REPLAY_CODE]
+    env = {k: v for k, v in os.environ.items() if k in {'PATH', 'LANG', 'LC_ALL'}}
+    proc = subprocess.run(command, input=json.dumps(inputs, ensure_ascii=True),
+        text=True, capture_output=True, env=env, timeout=90, check=False)
+    answers = [line.split('=', 1)[1] for line in proc.stdout.split('\n') if line.startswith('CLAW_SCHEMA_REPLAY=')]
+    if proc.returncode or len(answers) != 1:
+        raise ValueError('Frozen native schema replay failed: ' + proc.stderr[-1000:])
+    data = json.loads(answers[0])
+    if data['hashes'] != {'schema': SCHEMA_SHA, 'mcp': MCP_SHA} or set(data['results']) != set(inputs):
+        raise ValueError('Native schema implementation or replay coverage mismatch')
+    save_json(output / 'schema-replay.json', {**data, 'actor_image': IMAGE,
+        'inputs_sha256': hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest(),
+        'model_calls': 0, 'network': 'none', 'task_execution': False})
+    return data['results']
