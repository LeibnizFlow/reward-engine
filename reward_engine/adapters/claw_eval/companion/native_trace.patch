+"""Normalize actual native root lifecycle + branch wire evidence for Claw-Eval grading."""
+import json
+from pathlib import Path
+from opencode_baseline import (AuditSnapshot, Message, TextBlock, ToolDispatch, ToolResultBlock, ToolUseBlock,
+    TraceEnd, TraceMessage, TraceStart, TraceWriter)
+from opencode_runtime import save_json
+
+
+def jsonl(path):
+    return [json.loads(line) for line in path.read_bytes().split(b'\n') if line.strip()] if path.exists() else []
+
+
+def wire_answer(path):
+    text = path.read_text()
+    chunks = []
+    for line in text.split('\n'):
+        if line.startswith('data:') and line[5:].strip() != '[DONE]':
+            try:
+                chunks.append(json.loads(line[5:]))
+            except ValueError:
+                pass  # Partial interrupted SSE is separately retained as unknown usage, never a fabricated response.
+    if not chunks:
+        try:
+            chunks = [json.loads(text)]
+        except ValueError:
+            return None
+    content, reasoning, calls = '', '', {}
+    for row in chunks:
+        for choice in row.get('choices', []):
+            if choice.get('index', 0) != 0:
+                raise ValueError('Multiple completion choices are outside the protocol')
+            delta = choice.get('delta', choice.get('message', {})) or {}
+            content += delta.get('content') or ''
+            reasoning += delta.get('reasoning_content') or ''
+            for item in delta.get('tool_calls', []):
+                index = item.get('index', len(calls) if 'message' in choice else 0)
+                call = calls.setdefault(index, {'id': '', 'function': {'name': '', 'arguments': ''}})
+                if item.get('id'):
+                    call['id'] = item['id']
+                fn = item.get('function', {})
+                call['function']['name'] += fn.get('name') or ''
+                call['function']['arguments'] += fn.get('arguments') or ''
+    return {'role': 'assistant', 'content': content, 'reasoning_content': reasoning, 'tool_calls': list(calls.values())}
+
+
+def call_fields(call):
+    fn = call.get('function', call)
+    raw = fn.get('arguments') or {}
+    args = json.loads(raw) if isinstance(raw, str) else dict(raw)
+    if not isinstance(args, dict):
+        raise ValueError('Tool arguments are not an object')
+    # The native StreamEventRail strips this display-only field before execution.
+    args.pop('call_goal', None)
+    return call.get('id') or call.get('tool_call_id'), fn.get('name'), args
+
+
+def response_is_complete(path, meta):
+    """Partial wire bytes are evidence of a failed request, not committed tool calls.
+
+    A later request/native lifecycle can still prove a tool really executed.
+    Keep those records; never repair or invent the interrupted JSON arguments.
+    """
+    if (not path.exists() or meta.get('error') or meta.get('identity_ok') is False
+            or meta.get('stream_complete') is False):
+        return False
+    text = path.read_text()
+    if any(line.startswith('data:') for line in text.split('\n')):
+        return any(line.startswith('data:') and line[5:].strip() == '[DONE]'
+                   for line in text.split('\n'))
+    try:
+        return isinstance(json.loads(text), dict)
+    except ValueError:
+        return False
+
+
+def normalize(directory, task, trace_id, audits, wall, actor_error=None, *,
+              output_directory=None, argument_formatter=None):
+    native = directory / 'jiuwenswarm/native'
+    rows = jsonl(native / 'root-lifecycle.jsonl')
+    if not rows and actor_error is None:
+        raise ValueError('Passive native root capture missing')
+    destination = output_directory or directory
+    path = destination / 'trace.jsonl'
+    if path.exists():
+        raise ValueError('Never append a second reconstructed trace to an existing artifact')
+    records, all_calls, provenance = [], {}, []
+    for folder in sorted((directory / 'actor-http').iterdir()) if (directory / 'actor-http').exists() else []:
+        if not (folder / 'request.json').exists():
+            continue
+        meta = json.loads((folder / 'metadata.json').read_text()) if (folder / 'metadata.json').exists() else {'usage': {}, 'incomplete_metadata': True}
+        records.append(meta)
+        response = wire_answer(folder / 'response.txt') if (folder / 'response.txt').exists() else None
+        complete = response_is_complete(folder / 'response.txt', meta)
+        candidates = [*(json.loads((folder / 'request.json').read_text()).get('messages') or []),
+                      *([response] if response and complete else [])]
+        for msg in candidates:
+            for call in msg.get('tool_calls') or []:
+                cid, name, args = call_fields(call)
+                if not cid or not name:
+                    raise ValueError('Native tool call identity unavailable')
+                item = {'id': cid, 'name': name, 'arguments': args}
+                if cid in all_calls and all_calls[cid] != item:
+                    raise ValueError('Conflicting tool call ID across model consumers')
+                all_calls[cid] = item
+        provenance.append({'http_directory': str(folder.relative_to(directory)), 'response': response,
+                           'response_used_for_tool_identity': complete,
+                           'scope': 'root_or_internal_consumer; root tool IDs identified by native lifecycle'})
+    bridge = jsonl(directory / 'bridge-events.jsonl')
+    matched, transformed, formatted = {}, [], None
+    for row in bridge:
+        event = row['event']
+        name, args = event['tool_name'], event['request_body']
+        candidates = [v for cid, v in all_calls.items() if cid not in matched
+            and (v['name'] == name or any(v['name'].endswith(sep + name) for sep in ['_', '-', '__', '.']))
+            and v['arguments'] == args]
+        used_formatter = False
+        if not candidates and argument_formatter is not None:
+            # MCPTool.invoke applies native SchemaUtils before sending arguments.
+            # Replay that exact frozen implementation; never accept loose subsets,
+            # guessed defaults, or different actual execution values.
+            if formatted is None:
+                from mcp_task_bridge import tool_specs
+                specs = {t.name: t.input_schema for t in tool_specs(task)}
+                inputs = {}
+                for cid, call in all_calls.items():
+                    names = [n for n in specs if call['name'] == n or
+                             any(call['name'].endswith(sep + n) for sep in ['_', '-', '__', '.'])]
+                    if len(names) > 1:
+                        raise ValueError('Ambiguous native MCP tool schema')
+                    if names:
+                        inputs[cid] = {'arguments': call['arguments'], 'schema': specs[names[0]]}
+                formatted = argument_formatter(inputs, destination)
+            candidates = [v for cid, v in all_calls.items() if cid not in matched
+                and (v['name'] == name or any(v['name'].endswith(sep + name) for sep in ['_', '-', '__', '.']))
+                and cid in formatted and formatted[cid].get('ok') is True
+                and formatted[cid]['arguments'] == args]
+            used_formatter = bool(candidates)
+        if not candidates:
+            raise ValueError('Actual MCP dispatch has no corresponding native/wire tool call: ' + name)
+        item = candidates[0]
+        matched[item['id']] = row
+        if used_formatter:
+            transformed.append({'tool_call_id': item['id'], 'tool_name': name,
+                'model_arguments': item['arguments'], 'actual_MCP_arguments': args,
+                'proof': 'exact frozen MCPTool SchemaUtils replay'})
+    journal, root_ids = [], set()
+    for row in rows:
+        kind, data, epoch = row['kind'], row['data'], row['epoch']
+        if kind == 'after_model_call' and not row.get('exception_type') and isinstance(data.get('response'), dict):
+            response = data['response']
+            blocks = []
+            content = response.get('content') or ''
+            if content:
+                if not isinstance(content, str):
+                    raise ValueError('Non-text native assistant content is outside this cohort')
+                blocks.append(TextBlock(text=content))
+            for call in response.get('tool_calls') or []:
+                cid, name, args = call_fields(call)
+                root_ids.add(cid)
+                canonical = matched[cid]['event']['tool_name'] if cid in matched else name
+                blocks.append(ToolUseBlock(id=cid, name=canonical, input=args))
+            journal.append((epoch, TraceMessage(trace_id=trace_id, message=Message(role='assistant', content=blocks,
+                reasoning_content=response.get('reasoning_content')))))
+        elif kind == 'after_tool_call':
+            if row.get('exception_type') == 'ToolInterruptException' or (data.get('tool_msg') is None and data.get('tool_result') is None):
+                # Native interactive tools fire the after-hook while suspended;
+                # this is not an actual null result. The resumed result follows.
+                continue
+            cid, name, args = call_fields(data['tool_call'])
+            root_ids.add(cid)
+            msg = data.get('tool_msg') or {}
+            content = msg.get('content') if isinstance(msg, dict) else None
+            if content is None:
+                content = data.get('tool_result')
+            text = content if isinstance(content, str) else json.dumps(content, ensure_ascii=True)
+            native_result = data.get('tool_result')
+            is_error = bool(row.get('exception_type')) or (isinstance(native_result, dict) and native_result.get('success') is False)
+            if cid in matched:
+                is_error = is_error or bool(matched[cid]['result'].get('is_error'))
+            result = ToolResultBlock(tool_use_id=cid, content=[TextBlock(text=text)], is_error=is_error)
+            journal.append((epoch, TraceMessage(trace_id=trace_id, message=Message(role='user', content=[result]))))
+    visible_path = directory / 'jiuwenswarm/visible-conversation.json'
+    visible = json.loads(visible_path.read_text()) if visible_path.exists() else []
+    for row in visible:
+        role, epoch = row['info']['role'], row['epoch']
+        text = '\n'.join(p['text'] for p in row['parts'] if p['type'] == 'text')
+        if role == 'assistant':
+            earlier = [(stamp, event) for stamp, event in journal if stamp <= epoch and isinstance(event, TraceMessage)
+                       and event.message.role == 'assistant']
+            if earlier and max(earlier, key=lambda pair: pair[0])[1].message.text == text:
+                continue  # Final UI projection is the same actual native model output, not a second assistant turn.
+        journal.append((epoch, TraceMessage(trace_id=trace_id, message=Message(role=role, content=text))))
+    for cid, row in matched.items():
+        epoch = row.get('epoch', row.get('time', 0))
+        if cid not in root_ids:
+            call = all_calls[cid]
+            journal.append((epoch - 0.000002, TraceMessage(trace_id=trace_id, message=Message(role='assistant',
+                content=[ToolUseBlock(id=cid, name=row['event']['tool_name'], input=call['arguments'])]))))
+            journal.append((epoch + 0.000002, TraceMessage(trace_id=trace_id, message=Message(role='user',
+                content=[ToolResultBlock.model_validate({**row['result'], 'tool_use_id': cid})]))))
+        journal.append((epoch, ToolDispatch.model_validate({**row['event'], 'trace_id': trace_id, 'tool_use_id': cid})))
+    journal.sort(key=lambda item: item[0])
+    totals = {k: sum((r.get('usage') or {}).get(k, 0) for r in records) for k in ['prompt_tokens', 'completion_tokens']}
+    dialogue_path = directory / 'dialogue.json'
+    dialogue = json.loads(dialogue_path.read_text()) if dialogue_path.exists() else {}
+    with TraceWriter(path) as writer:
+        writer.write_event(TraceStart(trace_id=trace_id, task_id=task.task_id, model='deepseek-v4-flash', persona='jiuwenswarm-agent.work.normal-defaults'))
+        for _, event in journal:
+            writer.write_event(event)
+        for audit in audits:
+            writer.write_event(AuditSnapshot(trace_id=trace_id, **audit))
+        writer.write_event(TraceEnd(trace_id=trace_id, total_turns=len(records), input_tokens=totals['prompt_tokens'],
+            output_tokens=totals['completion_tokens'], total_tokens=sum(totals.values()),
+            model_input_tokens=totals['prompt_tokens'], model_output_tokens=totals['completion_tokens'], wall_time_s=wall,
+            model_time_s=sum(r.get('wall_seconds', 0) for r in records),
+            tool_time_s=sum(r['event'].get('latency_ms', 0) for r in bridge) / 1000,
+            user_agent_rounds=dialogue.get('user_agent_rounds', 0),
+            user_agent_max_rounds=task.user_agent.max_rounds if task.user_agent.enabled else 0,
+            user_agent_done=dialogue.get('user_agent_done', False),
+            failure_modes=[actor_error] if actor_error else []))
+    save_json(destination / 'native-trace-provenance.json', {'root_lifecycle_rows': len(rows), 'root_tool_ids': sorted(root_ids),
+        'MCP_dispatches': len(bridge), 'MCP_native_ID_mapping': {cid: r['event']['tool_use_id'] for cid, r in matched.items()},
+        'internal_MCP_calls_added_with_actual_IDs': sorted(set(matched) - root_ids), 'wire_responses': provenance,
+        'MCP_argument_transforms': transformed,
+        'total_turns_definition': 'all physical actor/internal model requests, not only root assistant messages',
+        'no_grade_or_persona_in_actor_context': True})
+    return path
