# Copy to a private environment file. Never commit populated credentials.
# Minimal live example (single model; see docs/quickstart.md):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_MODEL=your-model-name
# Native launchers default to YIBU_API_KEY, but accept another key variable:
# REWARD_ENGINE_KEY_ENV=OPENAI_API_KEY
# REWARD_ENGINE_BACKEND_URL=https://your-provider.example/v1
# Bailian Token Plan: role settings are in reward_engine/configs/bailian_token_plan.json.
# BAILIAN_TOKEN_PLAN_KEY=
OPENLUX_API_KEY=
YIBU_API_KEY=
YIBU_BASE_URL=
# Paths can instead be provided as environment variables.
# WORKBUDDY_ROOT=/path/to/workbuddy-runner
# CLAW_EVAL_ROOT=/path/to/data/claw_eval/benchmark
# OPENCODE_BINARY=/path/to/opencode
# REWARD_ENGINE_CREDENTIALS_FILE=/path/to/private.env
